---
import BaseLayout from "../layouts/BaseLayout.astro";
import { defaultSeo } from "../data/seo";
---

<BaseLayout bodyClass="home-page" title={defaultSeo.title} description={defaultSeo.description}>
  <main class="desk-stage" data-questionnaire-demo>
    <header class="site-chrome" aria-label="Site header">
      <a class="wordmark" href="/" aria-label="Questionnaire home">
        <span>questionnaire.dev</span>
        <em>Agent Skill</em>
      </a>
      <nav class="console-nav" aria-label="Primary">
        <a href="/docs/overview/">Overview</a>
        <a href="/docs/get-started/">Guides</a>
        <a href="/docs/state-schema/">Reference</a>
        <a href="/docs/browser-demo-boundaries/">Skill docs</a>
        <a href="/docs/artifact-model/">ADRs</a>
        <a href="/docs/question-types/">Examples</a>
      </nav>
      <div class="chrome-actions" aria-label="Utility">
        <a class="icon-link" href="https://github.com/srinitude/questionnaire" aria-label="GitHub">
          <svg class="github-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12.03 2C6.49 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.86 9.71.5.09.68-.22.68-.49 0-.24-.01-1.04-.01-1.89-2.79.62-3.38-1.22-3.38-1.22-.46-1.19-1.12-1.51-1.12-1.51-.91-.64.07-.63.07-.63 1.01.07 1.54 1.06 1.54 1.06.9 1.57 2.36 1.12 2.94.86.09-.66.35-1.12.64-1.37-2.23-.26-4.57-1.14-4.57-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.76 1.05A9.38 9.38 0 0 1 12.03 6c.85 0 1.7.12 2.49.34 1.92-1.32 2.76-1.05 2.76-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.35 4.81-4.59 5.06.36.32.68.95.68 1.92 0 1.39-.01 2.5-.01 2.84 0 .27.18.59.69.49A10.18 10.18 0 0 0 22 12.23C22 6.58 17.51 2 12.03 2Z" />
          </svg>
        </a>
        <div class="draft-pill"><span data-save-status>Local draft</span><i aria-hidden="true"></i></div>
      </div>
    </header>

    <section class="hero-console" id="demo" aria-labelledby="hero-title">
      <h1 id="hero-title">Run a questionnaire. Produce decision-grade artifacts.</h1>
      <p>Questionnaire is an Agent Skill for high-signal intake and decision scaffolding.</p>
      <p class="hero-kicker">Live questionnaire run</p>
    </section>

    <section class="workbench" id="run-panel" aria-label="Live questionnaire run">
      <aside class="console-panel rail-panel artifact-panel" aria-label="Artifact trail">
        <div class="brass-plate">Artifact trail</div>
        <div class="panel-inner">
          <ol class="question-steps" data-run-steps></ol>
          <a class="transcript-link" href="/docs/artifact-model/">View transcript.md</a>
        </div>
      </aside>

      <section class="console-panel active-panel" aria-label="Active questionnaire question">
        <div class="panel-inner">
          <div class="question-counter" data-question-counter>Question 1 of 6</div>
          <h2 data-question-prompt>Loading question...</h2>
          <p class="question-instruction">
            Define the underlying problem as clearly and specifically as possible. Focus on the root cause, not symptoms or solutions.
          </p>

          <div class="recommended-answer">
            <span>Recommended answer</span>
            <p data-question-recommendation></p>
            <button type="button" class="why-toggle" aria-controls="why-block" aria-expanded="true" data-why-toggle>Hide rationale</button>
          </div>

          <div class="why-block" id="why-block" data-why-block>
            <svg class="compass" viewBox="0 0 36 36" aria-hidden="true">
              <circle class="compass-ring" cx="18" cy="18" r="16"></circle>
              <path class="compass-axis" d="M18 7.5v4.2M18 24.3v4.2M7.5 18h4.2M24.3 18h4.2"></path>
              <path class="compass-needle" d="M18 10.2 21.7 18 18 25.8 14.3 18Z"></path>
              <circle class="compass-dot" cx="18" cy="18" r="1.7"></circle>
            </svg>
            <div>
              <strong>Why it matters</strong>
              <p data-question-why></p>
            </div>
          </div>

          <div class="options" data-question-options></div>
          <label class="answer-label" for="answer-input">Your answer (edit if needed)</label>
          <textarea
            id="answer-input"
            data-answer-input
            rows="4"
            aria-label="Your answer"
            placeholder="Write a specific answer. The demo autosaves locally."
          ></textarea>
          <div class="question-actions">
            <button class="button button-secondary" type="button" data-skip-button>Skip</button>
            <button class="button button-secondary mobile-reset" type="button" data-reset-button>Reset</button>
            <button class="button button-primary" type="button" data-answer-button>Save & continue<span aria-hidden="true">→</span></button>
          </div>
          <div class="validation-line" data-validation-state>Valid state</div>
        </div>
      </section>

      <aside class="console-panel rail-panel context-panel" aria-label="Context and export">
        <div class="brass-plate">Context & export</div>
        <div class="panel-inner">
          <p class="rail-label">Current context</p>
          <div class="artifact-list" data-artifacts></div>
          <p class="rail-label">Import / export</p>
          <div class="export-stack">
            <button type="button" class="import-control" data-import-button>Import context</button>
            <input
              type="file"
              class="hidden-file-input"
              data-import-json
              accept="application/json,.json"
              aria-label="Import context JSON"
            />
            <button type="button" class="button button-secondary" data-export-json>Export artifacts</button>
            <button type="button" class="button button-secondary" data-export-transcript>Export transcript</button>
          </div>
          <output class="import-status" data-import-status>Ready for import or export.</output>
          <div class="local-draft-note">
            <strong>Local draft <i aria-hidden="true"></i></strong>
            <p>Browser autosaves locally. Export is the handoff.</p>
            <div class="draft-note-actions">
              <a href="/docs/browser-demo-boundaries/">Docs →</a>
              <button type="button" data-reset-button>Reset</button>
            </div>
          </div>
        </div>
      </aside>
    </section>
  </main>
  <script src="../scripts/demo.ts"></script>
</BaseLayout>
